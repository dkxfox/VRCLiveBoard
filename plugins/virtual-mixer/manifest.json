{
  "id": "virtual-mixer",
  "name": "虚拟混音台",
  "version": "0.6.2",
  "author": "VRCLiveBoard 官方",
  "description": "把系统声音、麦克风、磁带/乐器等自定义输入混成一路送入虚拟跳线；S3 实时启停/可调参数/A-B 卡片；新增同步 cue 播放(sample-aligned) 与 CABLE 延迟测量。",
  "api": "2.0.0",
  "experimental": true,
  "minApp": "1.4.8",
  "permissions": {
    "network": [],
    "filesystem": {
      "read": [],
      "write": []
    },
    "process": true,
    "ports": []
  },
  "dependencies": {},
  "conflicts": [],
  "exclusive": [],
  "loadOrder": 80,
  "settings": [
    {
      "key": "autoStart",
      "label": "启用实时混音（保存后自动启动）",
      "type": "bool",
      "default": false,
      "hint": "关闭=停止；打开会启动实时采集/输出，首次请先填好设备"
    },
    {
      "key": "masterOutputDevice",
      "label": "主输出(虚拟跳线播放端)",
      "type": "text",
      "default": "",
      "hint": "如 CABLE Input；S2 使用"
    },
    {
      "key": "systemCaptureDevice",
      "label": "系统声音采集端",
      "type": "text",
      "default": "",
      "hint": "留空 = 默认播放设备；S2 使用"
    },
    {
      "key": "micCaptureDevice",
      "label": "麦克风输入",
      "type": "text",
      "default": "",
      "hint": "留空 = 默认录音设备；S2 使用"
    },
    {
      "key": "customCaptureDevice",
      "label": "自定义输入(磁带/乐器/声卡)",
      "type": "text",
      "default": "",
      "hint": "留空=关闭自定义通道；填录音设备名，如 麦克风 (USB Audio CODEC )"
    },
    {
      "key": "micGainDb",
      "label": "麦克风增益(dB)",
      "type": "number",
      "default": 4,
      "hint": "不同耳机/声卡麦克风电平不同，±6dB 内调；过高会削波"
    },
    {
      "key": "musicGain",
      "label": "音乐/自定义增益(0-2)",
      "type": "number",
      "default": 0.72,
      "hint": "磁带/乐器通道音量；0.72 为当前实机默认"
    },
    {
      "key": "systemGain",
      "label": "系统声音增益(0-2)",
      "type": "number",
      "default": 1,
      "hint": "系统回环音量"
    },
    {
      "key": "duckEnabled",
      "label": "启用讲话闪避",
      "type": "bool",
      "default": true,
      "hint": "麦克风讲话时自动压低音乐"
    },
    {
      "key": "duckDepthDb",
      "label": "闪避深度(dB)",
      "type": "number",
      "default": -15,
      "hint": "默认 -15；更负=压得更多"
    },
    {
      "key": "duckThresholdDb",
      "label": "闪避触发阈值(dBFS)",
      "type": "number",
      "default": -35,
      "hint": "环境噪声大时调高(如 -30)，麦克风轻时调低(如 -45)"
    },
    {
      "key": "duckAttackMs",
      "label": "闪避淡入(ms)",
      "type": "number",
      "default": 45,
      "hint": "默认 45；越大越缓"
    },
    {
      "key": "duckReleaseMs",
      "label": "闪避恢复(ms)",
      "type": "number",
      "default": 600,
      "hint": "默认 600；越大恢复越慢"
    },
    {
      "key": "duckHoldMs",
      "label": "闪避保持(ms)",
      "type": "number",
      "default": 650,
      "hint": "停顿后延迟回升，避免抽吸"
    },
    {
      "key": "duckLookaheadMs",
      "label": "闪避预看(ms)",
      "type": "number",
      "default": 8,
      "hint": "默认 8；过大有延迟"
    },
    {
      "key": "sidechainHpfHz",
      "label": "侧链高通(Hz)",
      "type": "number",
      "default": 120,
      "hint": "滤掉低频噪声再检测人声"
    }
  ],
  "changelog": [
    "0.6.2 Cue 增加麦克风回避开关(默认关) + 智能路径解析(Windows“复制文件地址”引号/ file:///); 保留 FLAC/电平表"
  ]
}
