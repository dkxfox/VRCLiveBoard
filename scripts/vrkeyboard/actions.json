{
  "action_manifest_version": 0,
  "default_bindings": [
    {
      "controller_type": "oculus_touch",
      "binding_url": "bindings_oculus_touch.json"
    },
    {
      "controller_type": "vd_hand_controller",
      "binding_url": "bindings_vd_hand_controller.json"
    },
    {
      "controller_type": "knuckles",
      "binding_url": "bindings_knuckles.json"
    },
    {
      "controller_type": "vive_controller",
      "binding_url": "bindings_vive_controller.json"
    },
    {
      "controller_type": "rift",
      "binding_url": "bindings_rift.json"
    }
  ],
  "actions": [
    {
      "name": "/actions/main/in/PointerPose",
      "type": "pose",
      "requirement": "optional"
    }
  ],
  "action_sets": [
    {
      "name": "/actions/main",
      "usage": "leftright"
    }
  ],
  "localization": [
    {
      "language_tag": "en_US",
      "action_sets": {
        "/actions/main": "VR Keyboard"
      },
      "actions": {
        "/actions/main/in/PointerPose": "Aim pose",
        "/actions/main/in/Trigger": "Trigger",
        "/actions/main/in/Grip": "Grip",
        "/actions/main/in/Scroll": "Scroll"
      }
    }
  ],
  "app_key": "vrcliveboard.vrkeyboard"
}
