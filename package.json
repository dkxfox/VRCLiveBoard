{
  "name": "vrcliveboard",
  "version": "1.4.0",
  "private": true,
  "description": "VRChat OSC 工具: 电脑状态 / 媒体 / 公告板(私有项目)",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "desktop": "electron electron/main.js",
    "gates": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%npm_package_json%\\..\\scripts\\checks\\run-gates.ps1\" -Smoke -AllowDirty",
    "gates:fast": "node \"%npm_package_json%\\..\\scripts\\checks\\html-inline-check.js\" && node \"%npm_package_json%\\..\\scripts\\checks\\ui-wiring.js\" && node \"%npm_package_json%\\..\\scripts\\checks\\frontend-boot.js\"",
    "selftest": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%npm_package_json%\\..\\scripts\\checks\\gate-selftest.ps1\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/jpn": "^1.0.0",
    "electron": "43.4.0",
    "osc": "^2.4.5",
    "systeminformation": "^5.33.5",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "ws": "8.21.3"
  }
}
