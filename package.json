{
  "name": "vrcliveboard",
  "version": "1.4.8",
  "private": true,
  "description": "VRChat OSC 工具: 电脑状态 / 媒体 / 公告板(私有项目)",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "desktop": "electron electron/main.js",
    "gates": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%npm_package_json%\\..\\scripts\\checks\\run-gates.ps1\" -Smoke -AllowDirty",
    "gates:fast": "node \"%npm_package_json%\\..\\scripts\\checks\\html-inline-check.js\" && node \"%npm_package_json%\\..\\scripts\\checks\\ui-wiring.js\" && node \"%npm_package_json%\\..\\scripts\\checks\\frontend-boot.js\"",
  "test:mixer": "node \"%npm_package_json%\\..\\plugins\\virtual-mixer\\test\\engine-selftest.js\"",
  "test:mixer:capture": "node \"%npm_package_json%\\..\\plugins\\virtual-mixer\\test\\capture-smoke.js\"",
  "test:mixer:cable": "node \"%npm_package_json%\\..\\plugins\\virtual-mixer\\test\\cable-smoke.js\"",
  "test:mixer:latency": "node \"%npm_package_json%\\..\\plugins\\virtual-mixer\\test\\latency-smoke.js\"",
  "test:mixer:cue": "node \"%npm_package_json%\\..\\plugins\\virtual-mixer\\test\\cue-smoke.js\"",
  "test:mixer:cueapi": "node \"%npm_package_json%\\..\\plugins\\virtual-mixer\\test\\cue-api-smoke.js\"",
    "selftest": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%npm_package_json%\\..\\scripts\\checks\\gate-selftest.ps1\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/jpn": "^1.0.0",
    "electron": "43.8.4",
    "opencc-js": "^1.4.2",
    "osc": "^2.4.5",
    "pinyin-input-method-engine": "^4.0.0",
    "systeminformation": "^5.33.19",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@node-rs/jieba": "^2.0.3",
    "pinyin-pro": "^3.29.4"
  }
}
